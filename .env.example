# Public web client configuration (Vercel: Production, Preview, Development)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_PROVIDER_MODE=production
VITE_LOCAL_PROVIDER_SCENARIO=

# Fusion Lab Engine runtime
ENGINE_ENVIRONMENT=development
ENGINE_MODE=local
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8787
ENGINE_LOG_LEVEL=info
ENGINE_LOCAL_PROVIDER_MARKUP_BPS=0

# Supabase server configuration (store production values in Vercel/Supabase,
# never in Git)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# Provider-test API runtime
TEST_PROVIDER_BASE_URL=
TEST_PROVIDER_API_KEY=
TEST_PROVIDER_HOST=127.0.0.1
TEST_PROVIDER_PORT=8788
TEST_PROVIDER_PUBLIC_URL=
TEST_PROVIDER_LOG_LEVEL=info
TEST_PAYMENT_WEBHOOK_SECRET=

# Durable execution runtime
ENGINE_DURABLE_RUNTIME_ENABLED=false
ENGINE_DURABLE_DB_PATH=.local/durable-execution.sqlite
ENGINE_DURABLE_TICK_MS=1000
